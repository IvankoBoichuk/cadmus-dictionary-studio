# Host port published on loopback for the API by Docker Compose.
CADMUS_API_PORT=8000

# Host port published for the production-built frontend by Docker Compose.
CADMUS_WEB_PORT=5173

# Safe local API metadata. Copy this file to .env only when overriding defaults.
CADMUS_NAME=cadmus-api
CADMUS_ENVIRONMENT=development
CADMUS_VERSION=0.1.0
CADMUS_PUBLIC_WEB_URL=http://localhost:5173

# PostgreSQL settings for local processes. Compose overrides the host to the
# internal service name "postgres"; any host binding is loopback-only.
CADMUS_DATABASE_NAME=cadmus
CADMUS_DATABASE_USER=cadmus
CADMUS_DATABASE_PASSWORD=cadmus-local
CADMUS_DATABASE_HOST=localhost
CADMUS_DATABASE_PORT=5432

# Loopback-only host port used for local database access.
CADMUS_POSTGRES_PORT=5432

# Compose services use the internal service name "redis" and port 6379.
# Redis is intentionally not published to the host by the standard Compose file.
CADMUS_REDIS_HOST=localhost
CADMUS_REDIS_PORT=6379
CADMUS_REDIS_BROKER_DATABASE=0
CADMUS_REDIS_RESULT_DATABASE=1

# Optional complete URL overrides. Keep credentials out of committed files.
# Host-side processes need an explicit secure Redis exposure strategy before
# these localhost URLs can be used with the standard Compose configuration.
# CADMUS_REDIS_BROKER_URL=redis://localhost:6379/0
# CADMUS_REDIS_RESULT_BACKEND_URL=redis://localhost:6379/1

# Optional full URL override. Leave unset to build it from the values above.
# CADMUS_DATABASE_URL=postgresql+psycopg://cadmus:change-me@localhost:5432/cadmus

# S3-compatible object storage. These are disposable local-development values,
# not production credentials. Compose overrides the endpoint to "minio:9000".
CADMUS_OBJECT_STORAGE_ENDPOINT=localhost:9000
CADMUS_OBJECT_STORAGE_ACCESS_KEY=cadmus-local-access
CADMUS_OBJECT_STORAGE_SECRET_KEY=cadmus-local-secret
CADMUS_OBJECT_STORAGE_BUCKET=cadmus
CADMUS_OBJECT_STORAGE_SECURE=false

# Loopback-only host ports for the local MinIO S3 API and administration console.
CADMUS_MINIO_API_PORT=9000
CADMUS_MINIO_CONSOLE_PORT=9001

# Maximum accepted dictionary PDF upload size, in bytes (default: 100 MiB).
CADMUS_MAX_UPLOAD_SIZE_BYTES=104857600

# nginx's client_max_body_size for the web container, in MiB. Must stay >=
# CADMUS_MAX_UPLOAD_SIZE_BYTES above (converted to MiB), or nginx rejects
# large uploads with 413 before they ever reach the API.
CADMUS_MAX_UPLOAD_SIZE_MB=100

# Local email delivery. Compose routes SMTP to Mailpit and exposes its inbox UI
# on loopback only.
CADMUS_SMTP_HOST=localhost
CADMUS_SMTP_PORT=1025
CADMUS_SMTP_USE_TLS=false
CADMUS_EMAIL_FROM=Cadmus <noreply@cadmus.local>
CADMUS_VERIFICATION_TOKEN_LIFETIME_HOURS=24
CADMUS_PASSWORD_RESET_TOKEN_LIFETIME_HOURS=1
CADMUS_SESSION_LIFETIME_HOURS=12
CADMUS_MAILPIT_UI_PORT=8025

# BH-30 decentralization.ua reference-data sync. Only the worker's
# `sync-geography` command reads these; the API never calls this API
# directly (it only ever reads the locally synced cache).
CADMUS_GEOGRAPHY_API_GRAPHQL_URL=https://decentralization.ua/graphql
CADMUS_GEOGRAPHY_API_REST_BASE_URL=https://decentralization.ua/api/v1
CADMUS_GEOGRAPHY_API_TIMEOUT_SECONDS=10.0
CADMUS_GEOGRAPHY_API_MAX_RETRIES=3

# BH-188 "Continue with Google" login. Optional: leave all three unset and the
# API simply does not mount the /auth/google routes. Create an OAuth 2.0
# Client ID in Google Cloud Console with authorized redirect URI
# http://localhost:5173/api/auth/google/callback (adjust the host/port if you
# override CADMUS_WEB_PORT), then set these from its client ID/secret. See
# apps/api/README.md for the full setup walkthrough.
# CADMUS_GOOGLE_OAUTH_CLIENT_ID=
# CADMUS_GOOGLE_OAUTH_CLIENT_SECRET=
# CADMUS_GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/api/auth/google/callback
