server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Must stay >= CADMUS_MAX_UPLOAD_SIZE_BYTES (apps/api), or nginx rejects
    # large dictionary PDF uploads with 413 before they ever reach the API.
    client_max_body_size ${CADMUS_MAX_UPLOAD_SIZE_MB}m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://${CADMUS_API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
